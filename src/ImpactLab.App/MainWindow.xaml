<Window
    x:Class="ImpactLab.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ImpactLab.App.Controls"
    Title="ImpactLab Engineering Workbench"
    Width="1360"
    Height="780"
    MinWidth="1120"
    MinHeight="700"
    WindowStartupLocation="CenterScreen"
    Foreground="{StaticResource TextBrush}"
    AutomationProperties.Name="ImpactLab engineering workbench"
    KeyboardNavigation.TabNavigation="Cycle"
>
    <Grid Background="{StaticResource WindowBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="218" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border
            Background="{StaticResource NavigationBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,1,0"
        >
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Margin="8,9,8,15">
                    <TextBlock Text="IMPACTLAB" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock
                        Text="Impact Simulation Workbench"
                        Style="{StaticResource MutedTextStyle}"
                        FontSize="11"
                        Margin="0,2,0,0"
                    />
                </StackPanel>
                <ListBox
                    Grid.Row="1"
                    ItemsSource="{Binding Tabs}"
                    SelectedItem="{Binding SelectedTab}"
                    Style="{StaticResource NavigationListStyle}"
                    AutomationProperties.Name="Workspace navigation"
                />
                <Border
                    Grid.Row="2"
                    Background="#181C21"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="10"
                    Margin="0,10,0,0"
                >
                    <StackPanel>
                        <TextBlock
                            Text="LOCAL WORKSPACE"
                            FontSize="10"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource MutedTextBrush}"
                        />
                        <TextBlock Text="Release build · net8.0" FontSize="11" Margin="0,3,0,0" />
                        <TextBlock
                            Text="Verification tools included"
                            FontSize="11"
                            Foreground="{StaticResource SuccessBrush}"
                        />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="14,10"
            >
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button
                            Content="New"
                            Command="{Binding NewAnalysisCommand}"
                            Style="{StaticResource ToolbarButtonStyle}"
                            AutomationProperties.Name="New analysis"
                        />
                        <Button
                            Content="Open..."
                            Click="OpenScenario_Click"
                            Style="{StaticResource ToolbarButtonStyle}"
                            AutomationProperties.Name="Open scenario"
                        />
                        <Button
                            Content="Save..."
                            Click="SaveProject_Click"
                            Style="{StaticResource ToolbarButtonStyle}"
                            AutomationProperties.Name="Save portable ImpactLab project"
                        />
                        <Separator Width="1" Height="22" Margin="8,0" />
                        <Button
                            Content="CSV"
                            Click="ExportResultsCsv_Click"
                            Style="{StaticResource ToolbarButtonStyle}"
                            AutomationProperties.Name="Export detailed result CSV"
                        />
                        <Button
                            Content="Report"
                            Click="ExportReport_Click"
                            Style="{StaticResource ToolbarButtonStyle}"
                            AutomationProperties.Name="Export engineering report"
                        />
                        <Button
                            Content="Animation"
                            Click="ExportAnimation_Click"
                            Style="{StaticResource ToolbarButtonStyle}"
                            AutomationProperties.Name="Export simulation animation"
                        />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="22,0" VerticalAlignment="Center">
                        <TextBlock
                            Text="{Binding AnalysisStatus}"
                            TextTrimming="CharacterEllipsis"
                            AutomationProperties.LiveSetting="Polite"
                        />
                        <TextBlock
                            Text="{Binding Backend.VerificationState}"
                            Foreground="{StaticResource WarningBrush}"
                            FontSize="11"
                            TextTrimming="CharacterEllipsis"
                        />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox
                            Width="235"
                            Margin="0,0,8,0"
                            ItemsSource="{Binding Backend.Backends}"
                            SelectedItem="{Binding Backend.Selected}"
                            DisplayMemberPath="DisplayName"
                            AutomationProperties.Name="Simulation backend"
                        />
                        <Button
                            Content="Solve"
                            Command="{Binding RunScenarioCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            AutomationProperties.Name="Run current scenario"
                        />
                    </StackPanel>
                </Grid>
            </Border>
            <TabControl
                Grid.Row="1"
                SelectedIndex="{Binding SelectedTabIndex}"
                Style="{StaticResource WorkspaceTabControlStyle}"
                AutomationProperties.Name="Engineering workspaces"
            >
                <TabItem Header="Start">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="36,30" MaxWidth="1120" HorizontalAlignment="Left">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock
                                    Text="Start an impact analysis"
                                    Style="{StaticResource PageTitleStyle}"
                                />
                                <TextBlock
                                    Text="Create a guided setup, assemble imported parts, or open a known example."
                                    Style="{StaticResource MutedTextStyle}"
                                    FontSize="14"
                                />
                            </StackPanel>
                            <Grid Grid.Row="1" Margin="0,24,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource PanelStyle}" Margin="0,0,12,0">
                                    <StackPanel>
                                        <TextBlock
                                            Text="Quick impact"
                                            Style="{StaticResource SectionTitleStyle}"
                                        />
                                        <TextBlock
                                            Text="Use parametric target and impactor geometry for a fast first simulation."
                                            Style="{StaticResource MutedTextStyle}"
                                            MinHeight="58"
                                        />
                                        <Button
                                            Content="Configure quick impact"
                                            Command="{Binding OpenQuickImpactCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Margin="0,14,0,0"
                                        />
                                    </StackPanel>
                                </Border>
                                <Border
                                    Grid.Column="1"
                                    Style="{StaticResource PanelStyle}"
                                    Margin="0,0,12,0"
                                >
                                    <StackPanel>
                                        <TextBlock
                                            Text="STL / OBJ assembly"
                                            Style="{StaticResource SectionTitleStyle}"
                                        />
                                        <TextBlock
                                            Text="Combine multiple parts, assign materials and layers, then define the moving impactor."
                                            Style="{StaticResource MutedTextStyle}"
                                            MinHeight="58"
                                        />
                                        <Button
                                            Content="Build an assembly"
                                            Command="{Binding OpenAssemblyCommand}"
                                            Margin="0,14,0,0"
                                        />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource PanelStyle}">
                                    <StackPanel>
                                        <TextBlock
                                            Text="Open project"
                                            Style="{StaticResource SectionTitleStyle}"
                                        />
                                        <TextBlock
                                            Text="Continue from a portable .impactlab project or an existing scenario file."
                                            Style="{StaticResource MutedTextStyle}"
                                            MinHeight="58"
                                        />
                                        <Button
                                            Content="Open project..."
                                            Click="OpenScenario_Click"
                                            Margin="0,14,0,0"
                                        />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Grid Grid.Row="2" Margin="0,24,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource PanelStyle}" Margin="0,0,12,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel>
                                            <TextBlock
                                                Text="Built-in examples"
                                                Style="{StaticResource SectionTitleStyle}"
                                            />
                                            <TextBlock
                                                Text="Start with a reproducible configuration before importing your own geometry."
                                                Style="{StaticResource MutedTextStyle}"
                                            />
                                        </StackPanel>
                                        <StackPanel
                                            Grid.Row="1"
                                            Orientation="Horizontal"
                                            Margin="0,14,0,0"
                                        >
                                            <ComboBox
                                                Width="280"
                                                ItemsSource="{Binding SampleNames}"
                                                SelectedItem="{Binding SelectedSampleName}"
                                                AutomationProperties.Name="Built-in sample"
                                            />
                                            <Button
                                                Content="Load example"
                                                Command="{Binding LoadSampleCommand}"
                                                Margin="8,3,0,8"
                                            />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource PanelStyle}">
                                    <StackPanel>
                                        <TextBlock
                                            Text="Recommended workflow"
                                            Style="{StaticResource SectionTitleStyle}"
                                        />
                                        <TextBlock Text="1  Geometry and assembly" Margin="0,3" />
                                        <TextBlock Text="2  Materials and contacts" Margin="0,3" />
                                        <TextBlock Text="3  Solve and verify" Margin="0,3" />
                                        <TextBlock Text="4  Inspect and export" Margin="0,3" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Simulation">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid
                            DataContext="{Binding Simulation}"
                            Margin="22"
                            AutomationProperties.Name="Engineering viewport"
                        >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="360" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock
                                    Text="Quick Impact Sandbox"
                                    Style="{StaticResource PageTitleStyle}"
                                />
                                <TextBlock
                                    Text="Interactive explicit-lattice impact path with replay, heatmaps and engineering telemetry."
                                    TextWrapping="Wrap"
                                    Foreground="#A9B8CA"
                                    Margin="0,4,0,12"
                                />
                                <TextBlock Text="Target geometry" />
                                <ComboBox
                                    ItemsSource="{Binding TargetGeometryKinds}"
                                    SelectedItem="{Binding SelectedTargetGeometry}"
                                />
                                <TextBlock Text="Target material" />
                                <ComboBox
                                    ItemsSource="{Binding Materials}"
                                    SelectedItem="{Binding SelectedTargetMaterial}"
                                    DisplayMemberPath="DisplayName"
                                />
                                <TextBlock Text="Mesh cell size (mm)" />
                                <TextBox Text="{Binding CellSizeMm,UpdateSourceTrigger=PropertyChanged}" />
                                <CheckBox
                                    Content="Front material layer"
                                    IsChecked="{Binding UseFrontLayer}"
                                    Margin="0,5"
                                />
                                <CheckBox
                                    Content="Secondary backing part"
                                    IsChecked="{Binding UseBackingPart}"
                                    Margin="0,5"
                                />
                                <TextBlock Text="Impactor geometry" />
                                <ComboBox
                                    ItemsSource="{Binding ImpactorGeometryKinds}"
                                    SelectedItem="{Binding SelectedImpactorGeometry}"
                                />
                                <TextBlock Text="Impactor material" />
                                <ComboBox
                                    ItemsSource="{Binding Materials}"
                                    SelectedItem="{Binding SelectedImpactorMaterial}"
                                    DisplayMemberPath="DisplayName"
                                />
                                <TextBlock Text="Impact speed (m/s)" />
                                <TextBox Text="{Binding ImpactSpeedMps,UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Duration (ms)" />
                                <TextBox Text="{Binding SimulationDurationMs,UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Time step (us)" />
                                <TextBox Text="{Binding TimeStepMicroseconds,UpdateSourceTrigger=PropertyChanged}" />
                                <Button
                                    Content="Run Quick Impact"
                                    Command="{Binding RunCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Margin="0,10,0,4"
                                    AutomationProperties.Name="Run quick impact sandbox"
                                />
                                <TextBlock
                                    Text="{Binding Status}"
                                    TextWrapping="Wrap"
                                    Foreground="#D8E0EA"
                                    AutomationProperties.LiveSetting="Polite"
                                />
                            </StackPanel>
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    Background="#101318"
                                    CornerRadius="3"
                                    MinHeight="360"
                                >
                                    <Viewport3D
                                        ClipToBounds="True"
                                        AutomationProperties.Name="3D simulation replay"
                                    >
                                        <Viewport3D.Camera>
                                            <PerspectiveCamera
                                                Position="0.5,0.5,0.45"
                                                LookDirection="-0.5,-0.5,-0.45"
                                                UpDirection="0,0,1"
                                                FieldOfView="45"
                                            />
                                        </Viewport3D.Camera>
                                        <ModelVisual3D>
                                            <ModelVisual3D.Content>
                                                <AmbientLight Color="#8894A8" />
                                            </ModelVisual3D.Content>
                                        </ModelVisual3D>
                                        <ModelVisual3D>
                                            <ModelVisual3D.Content>
                                                <DirectionalLight
                                                    Color="#FFFFFF"
                                                    Direction="-1,-1,-2"
                                                />
                                            </ModelVisual3D.Content>
                                        </ModelVisual3D>
                                        <ModelVisual3D Content="{Binding Scene}" />
                                    </Viewport3D>
                                </Border>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,6">
                                    <TextBlock Text="Heatmap" VerticalAlignment="Center" />
                                    <ComboBox
                                        Width="150"
                                        Margin="8,0,16,0"
                                        ItemsSource="{Binding HeatmapModes}"
                                        SelectedItem="{Binding SelectedHeatmap}"
                                    />
                                    <TextBlock
                                        Text="{Binding HeatmapRange}"
                                        VerticalAlignment="Center"
                                        Margin="0,0,16,0"
                                        Foreground="#A9B8CA"
                                    />
                                    <Button
                                        Content="Previous"
                                        Command="{Binding PreviousFrameCommand}"
                                        Margin="0,0,8,0"
                                    />
                                    <Button Content="Next" Command="{Binding NextFrameCommand}" />
                                    <TextBlock
                                        Text="{Binding FrameTimeMs,StringFormat=  Time: {0:F3} ms}"
                                        VerticalAlignment="Center"
                                        Margin="12,0,0,0"
                                    />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Margin="0,2,0,8">
                                    <Border Height="10" CornerRadius="5">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#143D73" Offset="0" />
                                                <GradientStop Color="#1E90FF" Offset="0.25" />
                                                <GradientStop Color="#34B8C5" Offset="0.50" />
                                                <GradientStop Color="#F2C14E" Offset="0.70" />
                                                <GradientStop Color="#E76F51" Offset="0.85" />
                                                <GradientStop Color="#B3261E" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <TextBlock
                                        Text="{Binding HeatmapMeaning}"
                                        Margin="0,5,0,0"
                                        Foreground="#A9B8CA"
                                        TextWrapping="Wrap"
                                    />
                                </StackPanel>
                                <UniformGrid Grid.Row="3" Columns="3" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding MaxDisplacementMm,StringFormat=Max displacement: {0:F3} mm}" />
                                    <TextBlock Text="{Binding BrokenSpringCount,StringFormat=Broken links: {0}}" />
                                    <TextBlock Text="{Binding PeakContactForceKn,StringFormat=Peak contact: {0:F2} kN}" />
                                    <TextBlock Text="{Binding PeakContactCount,StringFormat=Peak contacts: {0}}" />
                                    <TextBlock Text="{Binding ComputeMilliseconds,StringFormat=Compute: {0:F0} ms}" />
                                    <TextBlock Text="{Binding TelemetrySampleCount,StringFormat=Telemetry samples: {0}}" />
                                </UniformGrid>
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Geometry">
                    <Grid DataContext="{Binding Geometry}" Margin="22">
                        <StackPanel>
                            <TextBlock Text="Geometry" FontSize="24" FontWeight="Bold" />
                            <TextBlock
                                Text="Parametric / transformed / boolean geometry authoring"
                                Margin="0,8,0,0"
                            />
                            <TextBlock
                                Text="Use Open Scenario or a built-in sample for the verified end-to-end solve path."
                                TextWrapping="Wrap"
                                Foreground="#A9B8CA"
                                Margin="0,8,0,0"
                            />
                        </StackPanel>
                    </Grid>
                </TabItem>
                <TabItem Header="Assembly">
                    <Grid DataContext="{Binding Assembly}" Margin="22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="360" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.ColumnSpan="2">
                            <TextBlock
                                Text="Impact Scene / Assembly"
                                Style="{StaticResource PageTitleStyle}"
                            />
                            <TextBlock
                                Text="Combine multiple STL/OBJ parts while preserving material, layer, transform and impact role."
                                Foreground="#A9B8CA"
                                Margin="0,4,0,10"
                                TextWrapping="Wrap"
                            />
                            <WrapPanel>
                                <Button
                                    Content="Add STL / OBJ Parts..."
                                    Click="AddAssemblyParts_Click"
                                />
                                <Button
                                    Content="Remove Selected"
                                    Click="RemoveAssemblyPart_Click"
                                    Margin="8,0,0,0"
                                />
                                <Button
                                    Content="Mark as Impactor"
                                    Click="MarkAssemblyImpactor_Click"
                                    Margin="8,0,0,0"
                                />
                                <Button
                                    Content="Build Impact Scenario"
                                    Click="BuildAssemblyScenario_Click"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Margin="16,0,0,0"
                                />
                            </WrapPanel>
                            <TextBlock
                                Text="{Binding Status}"
                                Margin="0,10,0,10"
                                TextWrapping="Wrap"
                                Foreground="#7FD1AE"
                                AutomationProperties.LiveSetting="Polite"
                            />
                        </StackPanel>
                        <DataGrid
                            Grid.Row="1"
                            ItemsSource="{Binding Parts}"
                            SelectedItem="{Binding SelectedPart}"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            Margin="0,0,18,0"
                        >
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Header="Part"
                                    Binding="{Binding Name}"
                                    Width="2*"
                                />
                                <DataGridTextColumn
                                    Header="Role"
                                    Binding="{Binding Role}"
                                    Width="*"
                                    IsReadOnly="True"
                                />
                                <DataGridTextColumn
                                    Header="Material"
                                    Binding="{Binding Material.DisplayName}"
                                    Width="2*"
                                    IsReadOnly="True"
                                />
                                <DataGridTextColumn
                                    Header="Layer"
                                    Binding="{Binding LayerIndex}"
                                    Width="70"
                                />
                                <DataGridTextColumn
                                    Header="Triangles"
                                    Binding="{Binding TriangleCount}"
                                    Width="90"
                                    IsReadOnly="True"
                                />
                                <DataGridCheckBoxColumn
                                    Header="Closed"
                                    Binding="{Binding IsLikelyClosed}"
                                    Width="65"
                                    IsReadOnly="True"
                                />
                            </DataGrid.Columns>
                        </DataGrid>
                        <ScrollViewer
                            Grid.Row="1"
                            Grid.Column="1"
                            VerticalScrollBarVisibility="Auto"
                        >
                            <StackPanel>
                                <TextBlock Text="Assembly settings" FontWeight="SemiBold" />
                                <TextBlock Text="Name" />
                                <TextBox Text="{Binding AssemblyName,UpdateSourceTrigger=PropertyChanged}" />
                                <UniformGrid Columns="3" Margin="0,8,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Cell (mm)" />
                                        <TextBox Text="{Binding CellSizeMm}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Duration (ms)" />
                                        <TextBox Text="{Binding DurationMs}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="dt (µs)" />
                                        <TextBox Text="{Binding TimeStepMicroseconds}" />
                                    </StackPanel>
                                </UniformGrid>
                                <Separator />
                                <TextBlock
                                    Text="Selected part"
                                    FontWeight="SemiBold"
                                    Margin="0,10,0,4"
                                />
                                <TextBlock Text="Role" />
                                <ComboBox
                                    ItemsSource="{Binding Roles}"
                                    SelectedItem="{Binding SelectedPart.Role}"
                                />
                                <TextBlock Text="Material" />
                                <ComboBox
                                    ItemsSource="{Binding Materials}"
                                    SelectedItem="{Binding SelectedPart.Material}"
                                    DisplayMemberPath="DisplayName"
                                />
                                <TextBlock Text="Source unit" />
                                <ComboBox
                                    ItemsSource="{Binding LengthUnits}"
                                    SelectedItem="{Binding SelectedPart.SourceUnit}"
                                />
                                <UniformGrid Columns="2" Margin="0,8,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Layer index" />
                                        <TextBox Text="{Binding SelectedPart.LayerIndex}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Thickness (mm)" />
                                        <TextBox Text="{Binding SelectedPart.LayerThicknessMm}" />
                                    </StackPanel>
                                </UniformGrid>
                                <TextBlock Text="Translation XYZ (mm)" FontWeight="SemiBold" />
                                <UniformGrid Columns="3">
                                    <TextBox Text="{Binding SelectedPart.TranslationXmm}" />
                                    <TextBox Text="{Binding SelectedPart.TranslationYmm}" />
                                    <TextBox Text="{Binding SelectedPart.TranslationZmm}" />
                                </UniformGrid>
                                <TextBlock
                                    Text="Rotation XYZ (deg)"
                                    FontWeight="SemiBold"
                                    Margin="0,8,0,0"
                                />
                                <UniformGrid Columns="3">
                                    <TextBox Text="{Binding SelectedPart.RotationXDeg}" />
                                    <TextBox Text="{Binding SelectedPart.RotationYDeg}" />
                                    <TextBox Text="{Binding SelectedPart.RotationZDeg}" />
                                </UniformGrid>
                                <TextBlock
                                    Text="Scale XYZ"
                                    FontWeight="SemiBold"
                                    Margin="0,8,0,0"
                                />
                                <UniformGrid Columns="3">
                                    <TextBox Text="{Binding SelectedPart.ScaleX}" />
                                    <TextBox Text="{Binding SelectedPart.ScaleY}" />
                                    <TextBox Text="{Binding SelectedPart.ScaleZ}" />
                                </UniformGrid>
                                <TextBlock
                                    Text="Linear velocity XYZ (m/s)"
                                    FontWeight="SemiBold"
                                    Margin="0,8,0,0"
                                />
                                <UniformGrid Columns="3">
                                    <TextBox Text="{Binding SelectedPart.VelocityX}" />
                                    <TextBox Text="{Binding SelectedPart.VelocityY}" />
                                    <TextBox Text="{Binding SelectedPart.VelocityZ}" />
                                </UniformGrid>
                                <TextBlock
                                    Text="Imported parts are assembled without destructive mesh union. This preserves material and contact identity."
                                    TextWrapping="Wrap"
                                    Foreground="#D8A95A"
                                    Margin="0,12,0,0"
                                />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabItem>
                <TabItem Header="Import">
                    <Grid DataContext="{Binding Import}" Margin="22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="360" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Text="Mesh Import" Style="{StaticResource PageTitleStyle}" />
                            <TextBlock
                                Text="OBJ / STL geometry with explicit units"
                                Foreground="#A9B8CA"
                                Margin="0,4,0,12"
                            />
                            <Button Content="Choose OBJ / STL..." Click="ImportMesh_Click" />
                            <Button
                                Content="Use Imported Mesh as Impact Target"
                                Click="UseImportedTarget_Click"
                                Margin="0,8,0,0"
                                FontWeight="SemiBold"
                            />
                            <TextBlock Text="{Binding Path}" TextWrapping="Wrap" Margin="0,8,0,8" />
                            <TextBlock Text="Source unit" />
                            <ComboBox
                                ItemsSource="{Binding LengthUnits}"
                                SelectedItem="{Binding SourceUnit}"
                            />
                            <CheckBox
                                Content="Center at origin"
                                IsChecked="{Binding CenterAtOrigin}"
                                Margin="0,8,0,0"
                            />
                            <CheckBox
                                Content="Weld duplicate vertices"
                                IsChecked="{Binding WeldVertices}"
                                Margin="0,4,0,12"
                            />
                            <TextBlock Text="Target material" />
                            <ComboBox
                                ItemsSource="{Binding Materials}"
                                SelectedItem="{Binding SelectedTargetMaterial}"
                                DisplayMemberPath="DisplayName"
                            />
                            <TextBlock Text="Impactor material" />
                            <ComboBox
                                ItemsSource="{Binding Materials}"
                                SelectedItem="{Binding SelectedImpactorMaterial}"
                                DisplayMemberPath="DisplayName"
                            />
                            <TextBlock Text="Impact speed (m/s)" />
                            <TextBox Text="{Binding ImpactSpeedMps,UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Impactor diameter (mm)" />
                            <TextBox Text="{Binding ImpactorDiameterMm,UpdateSourceTrigger=PropertyChanged}" />
                            <Separator />
                            <TextBlock
                                Text="STL surface layer export"
                                FontWeight="SemiBold"
                                Margin="0,12,0,4"
                            />
                            <TextBlock Text="Layer count" />
                            <TextBox Text="{Binding LayerCount,UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Layer axis" />
                            <ComboBox
                                ItemsSource="{Binding LayerAxes}"
                                SelectedItem="{Binding LayerAxis}"
                            />
                            <Button
                                Content="Export STL Layers..."
                                Click="SplitStl_Click"
                                Margin="0,10,0,0"
                            />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock
                                Text="{Binding Status}"
                                TextWrapping="Wrap"
                                AutomationProperties.LiveSetting="Polite"
                            />
                            <TextBlock
                                Text="Exported files"
                                FontWeight="SemiBold"
                                Margin="0,16,0,6"
                            />
                            <ListBox ItemsSource="{Binding LayerPaths}" MinHeight="180" />
                            <TextBlock
                                Text="Layer export partitions the source surface for authoring. A watertight volumetric layer model must be checked before continuum analysis."
                                TextWrapping="Wrap"
                                Foreground="#D8A95A"
                                Margin="0,12,0,0"
                            />
                        </StackPanel>
                    </Grid>
                </TabItem>
                <TabItem Header="Materials">
                    <Grid DataContext="{Binding Materials}" Margin="22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="560" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.ColumnSpan="2">
                            <TextBlock
                                Text="Engineering Material Library"
                                Style="{StaticResource PageTitleStyle}"
                            />
                            <TextBlock
                                Text="Nominal built-in grades and project-specific user materials"
                                Foreground="#A9B8CA"
                                Margin="0,4,0,12"
                            />
                        </StackPanel>
                        <DataGrid
                            Grid.Row="1"
                            ItemsSource="{Binding Entries}"
                            SelectedItem="{Binding Selected}"
                            AutoGenerateColumns="False"
                            IsReadOnly="True"
                            CanUserAddRows="False"
                            Margin="0,0,16,0"
                        >
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Header="Material"
                                    Binding="{Binding Definition.DisplayName}"
                                    Width="2*"
                                />
                                <DataGridTextColumn
                                    Header="Category"
                                    Binding="{Binding Category}"
                                    Width="*"
                                />
                                <DataGridTextColumn
                                    Header="Density kg/m3"
                                    Binding="{Binding Definition.DensityKgPerM3}"
                                    Width="*"
                                />
                                <DataGridTextColumn
                                    Header="E Pa"
                                    Binding="{Binding Definition.YoungModulusPa}"
                                    Width="*"
                                />
                                <DataGridTextColumn
                                    Header="Yield Pa"
                                    Binding="{Binding Definition.EffectiveYieldStrengthPa}"
                                    Width="*"
                                />
                                <DataGridTextColumn
                                    Header="UTS Pa"
                                    Binding="{Binding Definition.UltimateTensileStrengthPa}"
                                    Width="*"
                                />
                                <DataGridTextColumn
                                    Header="Standard"
                                    Binding="{Binding Definition.Standard}"
                                    Width="2*"
                                />
                            </DataGrid.Columns>
                        </DataGrid>
                        <ScrollViewer
                            Grid.Row="1"
                            Grid.Column="1"
                            VerticalScrollBarVisibility="Auto"
                        >
                            <StackPanel>
                                <TextBlock
                                    Text="Material data sheet"
                                    FontWeight="SemiBold"
                                    FontSize="16"
                                />
                                <TextBlock
                                    Text="{Binding SelectedEvidenceSummary}"
                                    Style="{StaticResource MutedTextStyle}"
                                    Margin="0,4,0,8"
                                />
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,6,0">
                                        <TextBlock Text="Project material ID" />
                                        <TextBox Text="{Binding NewId}" />
                                    </StackPanel>
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="Display name" />
                                        <TextBox Text="{Binding NewName}" />
                                    </StackPanel>
                                </UniformGrid>
                                <TabControl>
                                    <TabItem Header="Physics">
                                        <StackPanel Margin="10">
                                            <TextBlock Text="Response model" />
                                            <ComboBox
                                                ItemsSource="{Binding ResponseKinds}"
                                                SelectedItem="{Binding ResponseKind}"
                                            />
                                            <UniformGrid Columns="2">
                                                <StackPanel Margin="0,0,6,0">
                                                    <TextBlock Text="Density (kg/m³)" />
                                                    <TextBox Text="{Binding DensityKgPerM3}" />
                                                </StackPanel>
                                                <StackPanel Margin="6,0,0,0">
                                                    <TextBlock Text="Young modulus (GPa)" />
                                                    <TextBox Text="{Binding YoungModulusGPa}" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,6,0">
                                                    <TextBlock Text="Poisson ratio" />
                                                    <TextBox Text="{Binding PoissonRatio}" />
                                                </StackPanel>
                                                <StackPanel Margin="6,0,0,0">
                                                    <TextBlock Text="Damping ratio" />
                                                    <TextBox Text="{Binding DampingRatio}" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,6,0">
                                                    <TextBlock Text="Yield strength (MPa)" />
                                                    <TextBox Text="{Binding YieldStrengthMPa}" />
                                                </StackPanel>
                                                <StackPanel Margin="6,0,0,0">
                                                    <TextBlock Text="Ultimate strength (MPa)" />
                                                    <TextBox Text="{Binding UltimateStrengthMPa}" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,6,0">
                                                    <TextBlock Text="Failure strain" />
                                                    <TextBox Text="{Binding FailureStrain}" />
                                                </StackPanel>
                                                <StackPanel Margin="6,0,0,0">
                                                    <TextBlock Text="Tangent modulus (GPa)" />
                                                    <TextBox Text="{Binding TangentModulusGPa}" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,6,0">
                                                    <TextBlock Text="Compression scale" />
                                                    <TextBox Text="{Binding CompressiveStrengthScale}" />
                                                </StackPanel>
                                                <StackPanel Margin="6,0,0,0">
                                                    <TextBlock Text="Rate sensitivity" />
                                                    <TextBox Text="{Binding RateSensitivity}" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,6,0">
                                                    <TextBlock Text="Thermal conductivity W/(m·K)" />
                                                    <TextBox Text="{Binding ThermalConductivity}" />
                                                </StackPanel>
                                                <StackPanel Margin="6,0,0,0">
                                                    <TextBlock Text="Specific heat J/(kg·K)" />
                                                    <TextBox Text="{Binding SpecificHeat}" />
                                                </StackPanel>
                                            </UniformGrid>
                                            <TextBlock Text="Display colour (#RRGGBB)" />
                                            <TextBox Text="{Binding ColorHex}" />
                                        </StackPanel>
                                    </TabItem>
                                    <TabItem Header="Evidence">
                                        <StackPanel Margin="10">
                                            <TextBlock Text="Standard / grade" />
                                            <TextBox Text="{Binding Standard}" />
                                            <TextBlock Text="Source name" />
                                            <TextBox Text="{Binding SourceName}" />
                                            <TextBlock Text="Source URI" />
                                            <TextBox Text="{Binding SourceUri}" />
                                            <TextBlock Text="Specification / test procedure" />
                                            <TextBox Text="{Binding Specification}" />
                                            <TextBlock Text="Batch / lot / specimen" />
                                            <TextBox Text="{Binding BatchOrLot}" />
                                            <TextBlock Text="Notes" />
                                            <TextBox
                                                Text="{Binding Notes}"
                                                AcceptsReturn="True"
                                                Height="70"
                                                TextWrapping="Wrap"
                                            />
                                        </StackPanel>
                                    </TabItem>
                                    <TabItem Header="Curves">
                                        <StackPanel Margin="10">
                                            <TextBlock Text="Tensile curve — one row: strain, stress_MPa" />
                                            <TextBox
                                                Text="{Binding TensileCurveText}"
                                                AcceptsReturn="True"
                                                Height="130"
                                                FontFamily="Consolas"
                                                VerticalScrollBarVisibility="Auto"
                                            />
                                            <TextBlock Text="Compressive curve — optional" />
                                            <TextBox
                                                Text="{Binding CompressiveCurveText}"
                                                AcceptsReturn="True"
                                                Height="100"
                                                FontFamily="Consolas"
                                                VerticalScrollBarVisibility="Auto"
                                            />
                                        </StackPanel>
                                    </TabItem>
                                    <TabItem Header="Uncertainty">
                                        <StackPanel Margin="10">
                                            <UniformGrid Columns="2">
                                                <StackPanel Margin="0,0,6,0">
                                                    <TextBlock Text="Yield minimum (MPa)" />
                                                    <TextBox Text="{Binding YieldMinimumMPa}" />
                                                </StackPanel>
                                                <StackPanel Margin="6,0,0,0">
                                                    <TextBlock Text="Yield maximum (MPa)" />
                                                    <TextBox Text="{Binding YieldMaximumMPa}" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,6,0">
                                                    <TextBlock Text="Young minimum (GPa)" />
                                                    <TextBox Text="{Binding YoungMinimumGPa}" />
                                                </StackPanel>
                                                <StackPanel Margin="6,0,0,0">
                                                    <TextBlock Text="Young maximum (GPa)" />
                                                    <TextBox Text="{Binding YoungMaximumGPa}" />
                                                </StackPanel>
                                            </UniformGrid>
                                            <Separator />
                                            <TextBlock Text="Calibration model" />
                                            <TextBox Text="{Binding CalibrationModel}" />
                                            <UniformGrid Columns="2">
                                                <StackPanel Margin="0,0,6,0">
                                                    <TextBlock Text="RMSE (MPa)" />
                                                    <TextBox Text="{Binding CalibrationRmseMPa}" />
                                                </StackPanel>
                                                <StackPanel Margin="6,0,0,0">
                                                    <TextBlock Text="MAE (MPa)" />
                                                    <TextBox Text="{Binding CalibrationMaeMPa}" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,6,0">
                                                    <TextBlock Text="R²" />
                                                    <TextBox Text="{Binding CalibrationRSquared}" />
                                                </StackPanel>
                                                <StackPanel Margin="6,0,0,0">
                                                    <TextBlock Text="Sample count" />
                                                    <TextBox Text="{Binding CalibrationSampleCount}" />
                                                </StackPanel>
                                            </UniformGrid>
                                        </StackPanel>
                                    </TabItem>
                                </TabControl>
                                <Button
                                    Content="Save as Project Material"
                                    Command="{Binding AddMaterialCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Margin="0,10,0,0"
                                />
                                <TextBlock
                                    Text="{Binding Status}"
                                    TextWrapping="Wrap"
                                    Margin="0,10,0,0"
                                    AutomationProperties.LiveSetting="Polite"
                                />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabItem>
                <TabItem Header="Loads">
                    <Grid DataContext="{Binding Loads}" Margin="22">
                        <TextBlock Text="Load cases" FontSize="24" FontWeight="Bold" />
                    </Grid>
                </TabItem>
                <TabItem Header="Boundaries">
                    <Grid DataContext="{Binding Boundaries}" Margin="22">
                        <TextBlock
                            Text="Boundary conditions / reactions"
                            FontSize="24"
                            FontWeight="Bold"
                        />
                    </Grid>
                </TabItem>
                <TabItem Header="Experiments">
                    <Grid DataContext="{Binding Experiments}" Margin="22">
                        <TextBlock
                            Text="Parallel / resumable experiments"
                            FontSize="24"
                            FontWeight="Bold"
                        />
                    </Grid>
                </TabItem>
                <TabItem Header="Calibration">
                    <Grid DataContext="{Binding Calibration}" Margin="22">
                        <TextBlock Text="Calibration studies" FontSize="24" FontWeight="Bold" />
                    </Grid>
                </TabItem>
                <TabItem Header="Verification">
                    <Grid DataContext="{Binding Verification}" Margin="22">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock
                                Text="Verification"
                                Style="{StaticResource PageTitleStyle}"
                            />
                            <TextBlock
                                Text="Compiled numerical benchmarks and portable integrity checks are reported separately."
                                Foreground="#A9B8CA"
                                Margin="0,8,0,0"
                            />
                            <TextBlock Text="{Binding BenchmarkSummary}" Margin="0,8,0,0" />
                            <TextBlock
                                Text="{Binding RunValiditySummary}"
                                FontWeight="SemiBold"
                                Margin="0,8,0,0"
                            />
                        </StackPanel>
                        <DataGrid
                            Grid.Row="1"
                            ItemsSource="{Binding RunValidityChecks}"
                            AutoGenerateColumns="True"
                            IsReadOnly="True"
                            CanUserAddRows="False"
                            Margin="0,12,0,0"
                        />
                    </Grid>
                </TabItem>
                <TabItem Header="Mobility">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid DataContext="{Binding Mobility}" Margin="22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="350" />
                                <ColumnDefinition Width="350" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="Vehicle Profile" FontSize="24" FontWeight="Bold" />
                                <TextBlock Text="Name" />
                                <TextBox Text="{Binding VehicleName}" />
                                <TextBlock Text="Mass (kg)" />
                                <TextBox Text="{Binding MassKg}" />
                                <TextBlock Text="Ground contact area (m²)" />
                                <TextBox Text="{Binding ContactAreaM2}" />
                                <TextBlock Text="Ground clearance (m)" />
                                <TextBox Text="{Binding GroundClearanceM}" />
                                <TextBlock Text="Maximum slope (deg)" />
                                <TextBox Text="{Binding MaximumSlopeDeg}" />
                                <TextBlock Text="Maximum step height (m)" />
                                <TextBox Text="{Binding MaximumStepM}" />
                                <TextBlock Text="Maximum water depth (m)" />
                                <TextBox Text="{Binding MaximumWaterDepthM}" />
                                <TextBlock Text="Target speed (m/s)" />
                                <TextBox Text="{Binding TargetSpeedMps}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,20,0">
                                <TextBlock Text="Terrain Cell" FontSize="24" FontWeight="Bold" />
                                <TextBlock Text="Slope (deg)" />
                                <TextBox Text="{Binding TerrainSlopeDeg}" />
                                <TextBlock Text="Roughness (m)" />
                                <TextBox Text="{Binding TerrainRoughnessM}" />
                                <TextBlock Text="Obstacle height (m)" />
                                <TextBox Text="{Binding ObstacleHeightM}" />
                                <TextBlock Text="Bearing strength (kPa)" />
                                <TextBox Text="{Binding BearingStrengthKPa}" />
                                <TextBlock Text="Friction coefficient" />
                                <TextBox Text="{Binding FrictionCoefficient}" />
                                <TextBlock Text="Water depth (m)" />
                                <TextBox Text="{Binding WaterDepthM}" />
                                <TextBlock
                                    Text="Supporting structure capacity (kN, 0=ground)"
                                    TextWrapping="Wrap"
                                />
                                <TextBox Text="{Binding StructuralCapacityKn}" />
                                <Button
                                    Content="Assess Traversability"
                                    Command="{Binding AssessCommand}"
                                    Margin="0,12,0,0"
                                    FontWeight="SemiBold"
                                />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock
                                    Text="Decision Support"
                                    FontSize="24"
                                    FontWeight="Bold"
                                />
                                <TextBlock
                                    Text="{Binding Status}"
                                    TextWrapping="Wrap"
                                    Margin="0,8,0,12"
                                    AutomationProperties.LiveSetting="Polite"
                                />
                                <DataGrid
                                    ItemsSource="{Binding Reasons}"
                                    AutoGenerateColumns="True"
                                    IsReadOnly="True"
                                    CanUserAddRows="False"
                                    MinHeight="120"
                                />
                                <Separator Margin="0,16" />
                                <TextBlock
                                    Text="ML Dataset Bootstrap"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                />
                                <TextBlock
                                    Text="Exports numeric features, labels, and a JSON schema compatible with TensorFlow CSV input. Synthetic labels mirror the screening equations and are not field truth."
                                    TextWrapping="Wrap"
                                    Foreground="#A9B8CA"
                                    Margin="0,6,0,8"
                                />
                                <TextBlock Text="Synthetic rows" />
                                <TextBox Text="{Binding SyntheticDatasetRows}" />
                                <Button
                                    Content="Export TensorFlow Dataset..."
                                    Click="ExportMobilityDataset_Click"
                                    Margin="0,10,0,0"
                                />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Post-processing">
                    <Grid DataContext="{Binding PostProcessing}" Margin="22">
                        <StackPanel>
                            <TextBlock
                                Text="Probes / energy / sections"
                                FontSize="24"
                                FontWeight="Bold"
                            />
                            <TextBlock Text="Probe series" Margin="0,12,0,4" />
                            <ListBox ItemsSource="{Binding Probes}" MinHeight="120" />
                        </StackPanel>
                    </Grid>
                </TabItem>
                <TabItem Header="Results">
                    <Grid Margin="22">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Text="Results Explorer"
                            Style="{StaticResource PageTitleStyle}"
                        />
                        <Grid Grid.Row="1" Margin="0,12,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Quantity" VerticalAlignment="Center" />
                                    <ComboBox
                                        Width="220"
                                        Margin="8,0,16,0"
                                        ItemsSource="{Binding Results.Fields}"
                                        SelectedItem="{Binding Results.Field}"
                                        AutomationProperties.Name="Result field"
                                    />
                                    <TextBlock Text="Frame" VerticalAlignment="Center" />
                                    <TextBox
                                        Width="80"
                                        Margin="8,0,0,0"
                                        Text="{Binding Results.FrameIndex,UpdateSourceTrigger=PropertyChanged}"
                                        AutomationProperties.Name="Result frame"
                                    />
                                </StackPanel>
                                <DataGrid
                                    ItemsSource="{Binding Results.Rows}"
                                    AutoGenerateColumns="True"
                                    IsReadOnly="True"
                                    CanUserAddRows="False"
                                    Background="#1D2733"
                                    Foreground="#E4EBF3"
                                    RowBackground="#1D2733"
                                    AlternatingRowBackground="#253343"
                                    BorderBrush="#3A4B60"
                                    GridLinesVisibility="Horizontal"
                                    HorizontalGridLinesBrush="#344559"
                                    FontSize="13"
                                    Margin="0,12,12,0"
                                >
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#28384B" />
                                            <Setter Property="Foreground" Value="#F1F5FA" />
                                            <Setter Property="BorderBrush" Value="#3A4B60" />
                                            <Setter Property="Padding" Value="7,5" />
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>
                                </DataGrid>
                            </StackPanel>
                            <Border
                                Grid.Column="1"
                                BorderBrush="#2A3442"
                                BorderThickness="1"
                                Padding="14"
                                Width="360"
                            >
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger
                                                Binding="{Binding LargeResults.IsAttached}"
                                                Value="True"
                                            >
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock
                                        Text="Large / out-of-core result stream"
                                        FontWeight="SemiBold"
                                    />
                                    <TextBlock Text="Field" Margin="0,10,0,0" />
                                    <TextBox Text="{Binding LargeResults.FieldId,UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="Frame" />
                                    <TextBox Text="{Binding LargeResults.FrameIndex,UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock
                                        Text="{Binding LargeResults.Status}"
                                        TextWrapping="Wrap"
                                        AutomationProperties.LiveSetting="Polite"
                                    />
                                    <TextBlock Text="{Binding LargeResults.Minimum,StringFormat=Minimum: {0:G5}}" />
                                    <TextBlock Text="{Binding LargeResults.Maximum,StringFormat=Maximum: {0:G5}}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock
                            Grid.Row="2"
                            Text="Run completion transitions here automatically for shell-level scenarios. Use Post-processing for probes/sections, Charts for plots and Reports for export workflows."
                            TextWrapping="Wrap"
                            Foreground="#A9B8CA"
                        />
                    </Grid>
                </TabItem>
                <TabItem Header="Charts">
                    <Grid DataContext="{Binding Charts}" Margin="18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Text="Interactive Engineering Chart"
                            FontSize="24"
                            FontWeight="Bold"
                        />
                        <controls:EngineeringChartControl
                            Grid.Row="1"
                            Document="{Binding Document}"
                            Margin="0,12,0,0"
                            AutomationProperties.Name="Engineering result chart"
                        />
                    </Grid>
                </TabItem>
                <TabItem Header="Runs">
                    <Grid DataContext="{Binding Runs}" Margin="22">
                        <TextBlock Text="Persistent run archive" FontSize="24" FontWeight="Bold" />
                    </Grid>
                </TabItem>
                <TabItem Header="Reports">
                    <Grid DataContext="{Binding Reports}" Margin="22">
                        <TextBlock Text="Engineering reports" FontSize="24" FontWeight="Bold" />
                    </Grid>
                </TabItem>
                <TabItem Header="Extensions">
                    <Grid
                        DataContext="{Binding Extensions}"
                        Margin="22"
                        AutomationProperties.Name="Extension security workspace"
                    >
                        <StackPanel>
                            <TextBlock
                                Text="Extension / plugin security"
                                FontSize="24"
                                FontWeight="Bold"
                            />
                            <TextBlock
                                Text="Untrusted packages use authenticated isolated-process hosting. Trusted in-process loading requires an explicit security plan."
                                TextWrapping="Wrap"
                                Margin="0,12,0,0"
                            />
                            <TextBlock
                                Text="{Binding Status}"
                                Margin="0,8,0,0"
                                AutomationProperties.LiveSetting="Polite"
                            />
                        </StackPanel>
                    </Grid>
                </TabItem>
                <TabItem Header="Diagnostics">
                    <Grid DataContext="{Binding Diagnostics}" Margin="22">
                        <TextBlock
                            Text="Performance / numerical diagnostics"
                            FontSize="24"
                            FontWeight="Bold"
                        />
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
